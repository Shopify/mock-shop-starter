# Copy this file to .env. Nothing in it is secret: this starter runs against mock.shop.
SESSION_SECRET="mock-shop-starter-dev-secret-change-me"

# mock.shop is many stores, each on its own host. Set PUBLIC_STORE_DOMAIN to one of
# the hosts listed at https://mock.shop/llms.txt to build against that store's catalog.
# Leave it unset for the default store at mock.shop (apparel basics).
# PUBLIC_STORE_DOMAIN=candles.mock.shop

# Do not set PUBLIC_STOREFRONT_API_TOKEN for a mock.shop host; mock.shop is tokenless.
# When you connect a real store, `npx shopify hydrogen env pull` fills in the real values.
